# bde2020 Hadoop 설정
# 환경변수 prefix(CORE_CONF_, HDFS_CONF_)가 core-site.xml / hdfs-site.xml 항목으로 변환됨
# (이중 밑줄 __ 은 '_' 로, 삼중 밑줄 ___ 은 '-' 로 변환)

# --- core-site.xml ---
# HDFS 기본 주소: 모든 클라이언트(Spark, hdfs CLI)가 이 주소로 접근
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# --- hdfs-site.xml ---
# WebHDFS 활성화 (Python hdfs 라이브러리가 9870 포트로 접근하기 위해 필요)
HDFS_CONF_dfs_webhdfs_enabled=true
# 권한 검사 비활성화 (개발 편의 - 운영에서는 권장하지 않음)
HDFS_CONF_dfs_permissions_enabled=false
# datanode를 hostname이 아닌 IP로 등록 허용 (컨테이너 환경 안정성)
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# 단일 datanode 환경이므로 복제 계수 1
HDFS_CONF_dfs_replication=1
