# Frontend가 인식하는 전체 환경변수 명세다. VITE_API_BASE_URL은 빌드 결과에
# 포함되므로 secret을 넣지 않는다. 루트 production Compose는 /api를 고정한다.

# ── 선택: 직접 Vite 개발 서버 실행 ─────────────────────────────────────────
VITE_API_BASE_URL=/api
# /api 요청을 루트 Compose gateway로 proxy한다. 절대 API URL을 쓰면 비워 둔다.
VITE_API_PROXY_TARGET=http://localhost:8081
