# Copy values into your shell or a private env file. Never commit real values.

# env-contract: required
# ── 필수 ──────────────────────────────────────────────────────────────────
RAG_INSTANCE_ID=your-id
# Use URL-safe characters because Compose constructs DATABASE_URL from this value.
RAG_POSTGRES_PASSWORD=

# env-contract: optional
# ── 선택: Compose 기본값 재정의 ─────────────────────────────────────────────
RAG_POSTGRES_PORT=55432
RAG_POSTGRES_DB=retirewise_db
RAG_POSTGRES_USER=retirewise
# Set these only if your host checkout is not owned by uid/gid 1000.
RAG_OPERATOR_UID=1000
RAG_OPERATOR_GID=1000

# Required only for qualify. This is the GMS key, not a personal Google API key.
GOOGLE_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBED_DIM=3072
# 비우면 operator가 현재 Git revision을 provenance로 사용한다.
RAG_SOURCE_REVISION=
