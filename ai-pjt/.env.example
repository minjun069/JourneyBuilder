# AI 서비스와 ai-pjt 운영 CLI가 인식하는 전체 환경변수 명세다. 직접 실행할 때만
# .env로 복사한다. 루트 Compose의 내부 고정값도 서비스 명세에는 빠짐없이 기록한다.

# ── 필수: 현재 Compose 실행 기준 ────────────────────────────────────────────
DATABASE_URL=postgresql://retirewise:change-me@postgres:5432/retirewise_db
AI_SERVICE_BEARER_TOKEN=change-me
# 서비스 인증 token과 다른 32바이트 이상의 HMAC 가명화 키를 사용한다.
AI_MASKING_PSEUDONYM_KEY=change-me
# 현재 embedding provider가 Gemini로 고정돼 있으므로 GMS 키가 항상 필요하다.
GOOGLE_API_KEY=

# 요청별 LangGraph checkpoint와 완료 context/terminal receipt 보존 정책.
AI_CONTEXT_EXECUTION_TTL_SECONDS=600
AI_CONTEXT_RECEIPT_TTL_SECONDS=86400
AI_CONTEXT_CLOSED_RETENTION_SECONDS=86400
AI_CONTEXT_CLEANUP_INTERVAL_SECONDS=300

# ── 선택: LLM provider와 model 재정의 ──────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
# LLM_PROVIDER=openai|opensource 경로에서 사용한다.
OPENAI_API_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# ── 서비스 인식값: 루트 Compose에서는 승인값으로 고정 ───────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
RAG_FINANCIAL_COLLECTION=financial-knowledge
RAG_INTERFACE_COLLECTION=interface-guides
EMBED_DIM=3072
# raw model callback tracing은 허용하지 않는다.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# ── 선택: RAG 검색·인덱스 운영 ─────────────────────────────────────────────
RAG_TOP_K=5
RAG_FETCH_K=10
RAG_MIN_DENSE_SCORE=0.30
RAG_INDEX_RETENTION_DAYS=30
# 운영 indexing CLI의 provenance override. 비우면 현재 Git revision을 쓴다.
RAG_SOURCE_REVISION=

# ── 선택: 런타임·readiness·개발 override ───────────────────────────────────
LOG_LEVEL=INFO
READINESS_HTTP_URL=http://127.0.0.1:8001/api/system/v1/health
READINESS_TIMEOUT_SECONDS=2
# 현재 readiness 의존성은 아니며 미래 checkpointer migration용이다.
REDIS_URL=redis://redis:6379/0
# 기본 bundled registry 대신 다른 fixture를 검증할 때만 쓴다.
STEP_REGISTRY_PATH=

# ── 선택: 마스킹 안전 Langfuse exporter ────────────────────────────────────
# LANGFUSE_ENABLED=true이면 public/secret/base URL 세 값을 모두 채운다.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=default
LANGFUSE_RELEASE=
