# Copy this file to .env for direct local execution. Never commit real values.

# Provider selection. GOOGLE_API_KEY is required for gemini; OPENAI_API_KEY is
# required for openai. An OpenAI-compatible local provider may use a dummy key.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# Required by the current PostgreSQL checkpointer and readiness probe.
# P03 must inject credentials and align the host/database with its Compose service.
DATABASE_URL=postgresql://retirewise:change-me@postgres:5432/retirewise_db

# Backend callback target used by the current runtime.
BACKEND_URL=http://backend:8000

# Current legacy callback secret. I05 must replace this optional contract with
# required, non-empty AI_SERVICE_BEARER_TOKEN validation for v2 transport.
AI_CALLBACK_SECRET=
AI_SERVICE_BEARER_TOKEN=

# Retrieval defaults.
RAG_COLLECTION=retirement_docs
RAG_TOP_K=5
EMBED_DIM=3072

# Container readiness. The HTTP URL is local to the AI container.
READINESS_HTTP_URL=http://127.0.0.1:8001/health
READINESS_TIMEOUT_SECONDS=2

# Optional Redis address for a future checkpointer migration. It is not part of
# the current AI readiness condition or default dependency installation.
REDIS_URL=redis://redis:6379/0

# Optional tracing. Leave disabled unless keys and a reviewed exporter exist.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
