# Copy this file to .env for direct local execution. Never commit real values.

# Provider selection. GOOGLE_API_KEY is required for gemini; OPENAI_API_KEY is
# required for openai. An OpenAI-compatible local provider may use a dummy key.
#
# GOOGLE_API_KEY 에는 GMS 키를 넣는다(개인 Google 계정 키가 아니다). GMS 키는 Google 로 직접
# 가면 API_KEY_INVALID 로 거부되므로, GOOGLE_GEMINI_BASE_URL 로 요청 대상을 GMS 로 돌린다.
# 임베딩은 google-genai SDK 가 이 값을 직접 읽고, 채팅은 core/llm.py 가 client_options 로 넘긴다.
# Compose 실행은 루트와 prod override가 GOOGLE_GEMINI_BASE_URL·EMBEDDING_MODEL 을 고정한다.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
# OPENAI_API_KEY 와 LLM_BASE_URL 은 LLM_PROVIDER=openai|opensource 경로 전용이다.
OPENAI_API_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# Required by the current PostgreSQL checkpointer and readiness probe.
# P03 must inject credentials and align the host/database with its Compose service.
DATABASE_URL=postgresql://retirewise:change-me@postgres:5432/retirewise_db

# Required at startup for authenticated Django-to-AI SSE requests.
AI_SERVICE_BEARER_TOKEN=change-me
# HMAC 가명화 전용 키. 서비스 인증 토큰과 다른 32바이트 이상의 값을 사용합니다.
AI_MASKING_PSEUDONYM_KEY=change-me

# Retrieval defaults. Logical collections are fixed by the approved catalog.
RAG_FINANCIAL_COLLECTION=financial-knowledge
RAG_INTERFACE_COLLECTION=interface-guides
RAG_TOP_K=5
RAG_FETCH_K=10
RAG_MIN_DENSE_SCORE=0.30
RAG_INDEX_RETENTION_DAYS=30
EMBED_DIM=3072

# Container readiness. The HTTP URL is local to the AI container.
READINESS_HTTP_URL=http://127.0.0.1:8001/api/system/v1/health
READINESS_TIMEOUT_SECONDS=2

# Optional Redis address for a future checkpointer migration. It is not part of
# the current AI readiness condition or default dependency installation.
REDIS_URL=redis://redis:6379/0

# Optional tracing. Leave disabled unless keys and a reviewed exporter exist.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
