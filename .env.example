# S15P21B109 루트 compose 환경변수 서식
#
# 이 파일은 "무엇을 채워야 하는지"만 보여준다. 실제 값이 든 .env 는 커밋하지 않는다(.gitignore).
# 만드는 법 (한 번만):   bash deploy/make-env.sh            → 루트 .env 생성 (무작위 안전값 + GOOGLE_API_KEY 는 직접 입력)
# 서버:                  bash deploy/make-env.sh --output /srv/s15p21b109/secrets/app.env
# 확인:                  docker compose config --quiet      (필수값 누락이면 여기서 실패한다)
#
# 규칙
#   - 로컬은 팀원 각자 생성, 서버는 한 파일. 서로 값을 공유하거나 복사하지 않는다.
#   - POSTGRES_PASSWORD 는 postgres_data 볼륨을 처음 만들 때 DB 안에 굳는다. 볼륨이 있는 상태에서 값을 바꾸면
#     데이터는 남지만 접속이 끊긴다. 바꿔야 하면 DB 에서 ALTER USER 후 파일을 갱신한다. 서버에서 `down -v` 금지.
#   - change-me / password / postgres / secret / ssafy 같은 값은 기동 시 거부된다(config/runtime_env.py).
#   - 각 서비스가 읽는 전체 변수와 설명은 backend-pjt/.env.example, ai-pjt/.env.example 을 따른다. 이 파일은 그 합집합 중
#     루트 docker-compose.yml / docker-compose.prod.yml 이 참조하는 것만 모았다.

# ── 필수 5개 (compose 가 ${VAR:?} 로 강제) ──────────────────────────────────
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
AI_SERVICE_BEARER_TOKEN=
AI_MASKING_PSEUDONYM_KEY=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>  — make-env.sh 가 자동 조립
DATABASE_URL=

# ── LLM 공급자 (GMS 경유 gemini) ───────────────────────────────────────────
# GOOGLE_API_KEY 에는 **GMS 키**를 넣는다 (개인 Google 계정 키를 쓰지 않는다).
# 변수명이 GOOGLE_API_KEY 인 것은 ai-pjt 가 이 이름으로만 읽기 때문이고(core/config.py),
# 실제 호출은 GOOGLE_GEMINI_BASE_URL 을 통해 GMS 로 간다. 발급: https://gms.ssafy.io → GMS Key
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
# EMBEDDING_MODEL 과 GOOGLE_GEMINI_BASE_URL 은 여기서 다루지 않는다 —
# GMS 가 정하는 값이라 루트 compose와 prod override에 고정돼 있다 (gemini-embedding-2, 벡터 3072).
# LLM_BASE_URL 은 OpenAI 호환 경로(ChatOpenAI)용이며 현재 gemini 구성에서는 쓰이지 않는다.
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_DEBUG=false
# 서버는 도메인 추가: j15b109.p.ssafy.io,localhost,127.0.0.1,backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── PostgreSQL (바꾸면 DATABASE_URL 도 함께) ───────────────────────────────
POSTGRES_DB=retirewise_db
POSTGRES_USER=retirewise

# ── Backend → AI SSE ─────────────────────────────────────────────────────
AI_SERVICE_TIMEOUT_SECONDS=5
AI_STREAM_READ_TIMEOUT_SECONDS=120
READINESS_TIMEOUT_SECONDS=2

# ── RAG ──────────────────────────────────────────────────────────────────
RAG_COLLECTION=retirement_docs
RAG_TOP_K=5
EMBED_DIM=3072

# ── web (docker-compose.prod.yml) ────────────────────────────────────────
# VITE_API_BASE_URL 은 env 로 다루지 않는다 — front-pjt/Dockerfile 의 ARG 기본값이 유일한 출처다 (S15P21B109-130).
WEB_HOST_PORT=8080

# ── gateway (루트 compose, 오수만 09-07 추가: API 전용 nginx, SSE 튜닝) ──────────
# 기본값 8080 은 web 과 겹치고 0.0.0.0 에 바인딩된다. 운영·prod override 와 같이 쓸 때는 loopback 다른 포트로.
# 형식이 "<값>:80" 이므로 "127.0.0.1:8081" 처럼 IP 를 포함해 쓸 수 있다.
API_GATEWAY_PORT=127.0.0.1:8081

# ── 선택: 추적 (비우면 비활성) ────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
