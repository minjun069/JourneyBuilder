# S15P21B109 루트 Compose 환경변수 서식
#
# 이 파일은 루트 docker-compose.yml + docker-compose.prod.yml 운영자가 입력하거나
# 기본값에서 실제로 바꿀 수 있는 값만 담는다. 서비스가 인식하는 전체 변수 명세는
# backend-pjt/.env.example, ai-pjt/.env.example, front-pjt/.env.example 을 따른다.
# Compose에 고정한 내부 주소·포트·보안값·RAG catalog 값은 여기에 중복하지 않는다.
#
# 생성: bash deploy/make-env.sh
# 서버: bash deploy/make-env.sh --output /srv/s15p21b109/secrets/app.env
# 확인: docker compose --env-file .env config --quiet
#
# POSTGRES_PASSWORD는 postgres_data 볼륨 생성 시 DB에 저장된다. 기존 볼륨에서 바꾸려면
# DB의 ALTER USER를 먼저 수행한다. 서버에서 `docker compose down -v`를 실행하지 않는다.

# env-contract: required
# ── 필수: 빈 값이면 Compose 설정 단계에서 실패 ───────────────────────────────
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
AI_SERVICE_BEARER_TOKEN=
AI_MASKING_PSEUDONYM_KEY=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# deploy/make-env.sh가 위 DB 값으로 자동 조립한다.
DATABASE_URL=
# 현재 고정 embedding provider가 Gemini이므로 항상 필요하다. 개인 Google 키가 아닌 GMS 키를 넣는다.
GOOGLE_API_KEY=

# env-contract: optional
# ── 선택: Compose 기본값 재정의 ─────────────────────────────────────────────
# 아래 값은 모두 Compose에 안전한 기본값이 있다. 실제 환경에서 바꿀 항목만 수정한다.

# 외부 접근·DB 식별자. POSTGRES_DB/USER를 바꾸면 DATABASE_URL도 함께 바꾼다.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=retirewise_db
POSTGRES_USER=retirewise

# Backend → AI SSE와 readiness 조정값.
AI_SERVICE_TIMEOUT_SECONDS=5
AI_STREAM_READ_TIMEOUT_SECONDS=120
READINESS_TIMEOUT_SECONDS=2

# AI 요청별 임시 checkpoint와 완료 context/receipt 정리 주기.
AI_CONTEXT_EXECUTION_TTL_SECONDS=600
AI_CONTEXT_RECEIPT_TTL_SECONDS=86400
AI_CONTEXT_CLOSED_RETENTION_SECONDS=86400
AI_CONTEXT_CLEANUP_INTERVAL_SECONDS=300
AI_CONTEXT_MEMORY_INTERVAL_SECONDS=5
AI_CONTEXT_MEMORY_TOP_K=5
AI_CONTEXT_EMBEDDING_BATCH_SIZE=8

# LLM 변경값. OPENAI_API_KEY/LLM_BASE_URL은 LLM_PROVIDER를 바꿀 때만 사용한다.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0
OPENAI_API_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# RAG 검색·보존 tuning. collection, embedding provider/model/dimension은 Compose 고정값이다.
RAG_TOP_K=5
RAG_FETCH_K=10
RAG_MIN_DENSE_SCORE=0.54
RAG_INDEX_RETENTION_DAYS=30

# 호스트 공개 포트. 운영에서는 loopback binding을 유지한다.
API_GATEWAY_PORT=127.0.0.1:8081
WEB_HOST_PORT=8080

# 마스킹 안전 Langfuse exporter. 활성화할 때 세 연결값을 모두 채운다.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=default
# 이미지에 기록할 source revision. deploy.sh는 CI_COMMIT_SHA 또는 현재 Git SHA로 덮어쓴다.
APP_RELEASE=local
