# Copy this file to .env for local orchestration. Never commit real values.
#
# Django and PostgreSQL runtime settings read these values directly.

# Required Django settings. Placeholder values are intentionally not valid
# production credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Required PostgreSQL connection. Compose owns the matching service and
# credential injection.
POSTGRES_DB=retirewise_db
POSTGRES_USER=retirewise
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Required by the current Backend AI request-state implementation.
REDIS_URL=redis://redis:6379/0

# Backend-to-AI request and callback targets.
AI_SERVICE_URL=http://ai-pjt:8001/chat
AI_CALLBACK_URL=http://backend:8000/api/ai/callback/
AI_REQUEST_TTL_SECONDS=600
AI_SERVICE_TIMEOUT_SECONDS=5

# Required at startup. Follow-up transport work must use it for request and
# callback authentication and then remove the legacy optional secret.
AI_SERVICE_BEARER_TOKEN=change-me
AI_CALLBACK_SECRET=

# Container-local readiness probe configuration.
READINESS_HOST=127.0.0.1
READINESS_PORT=8000
READINESS_TIMEOUT_SECONDS=2
