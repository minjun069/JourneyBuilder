# Backend가 인식하는 전체 환경변수 명세다. 직접 실행할 때만 .env로 복사하고,
# 루트 Compose 실행에서는 루트 .env.example에 공개된 운영값만 조정한다.

# ── 필수: 안전한 실제 값을 주입 ─────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
AI_SERVICE_BEARER_TOKEN=change-me

# ── 선택: Django와 PostgreSQL 기본값 재정의 ─────────────────────────────────
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=retirewise_db
POSTGRES_USER=retirewise
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# E2E처럼 별도 search_path를 쓸 때만 설정한다.
POSTGRES_SCHEMA=

# ── 선택: Redis와 Backend → AI SSE ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# 격리 실행에서 key prefix가 필요할 때만 설정한다. 값은 콜론(:)으로 끝나야 한다.
AI_REDIS_NAMESPACE=
AI_SERVICE_URL=http://ai-pjt:8001
AI_SERVICE_TIMEOUT_SECONDS=5
AI_STREAM_READ_TIMEOUT_SECONDS=120

# ── 선택: 컨테이너 readiness ───────────────────────────────────────────────
READINESS_HOST=127.0.0.1
READINESS_PORT=8000
READINESS_TIMEOUT_SECONDS=2

# ── 선택: `python manage.py create_pb` 전용 ─────────────────────────────────
# 명령 인자 --password를 쓰면 설정하지 않는다.
PB_PASSWORD=
